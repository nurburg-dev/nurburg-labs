# Apache Maven Wrapper startup script, version 3.3.2

if [ -z "$MAVEN_SKIP_RC" ]; then
  if [ -f /usr/local/etc/mavenrc ]; then . /usr/local/etc/mavenrc; fi
  if [ -f /etc/mavenrc ]; then . /etc/mavenrc; fi
  if [ -f "$HOME/.mavenrc" ]; then . "$HOME/.mavenrc"; fi
fi

cygwin=false
darwin=false
mingw=false
case "$(uname)" in
  CYGWIN*) cygwin=true ;;
  MINGW*)  mingw=true  ;;
  Darwin*) darwin=true
    if [ -z "$JAVA_HOME" ]; then
      if [ -x "/usr/libexec/java_home" ]; then
        JAVA_HOME="$(/usr/libexec/java_home)"
        export JAVA_HOME
      else
        JAVA_HOME="/Library/Java/Home"
        export JAVA_HOME
      fi
    fi
    ;;
esac

if [ -z "$JAVA_HOME" ]; then
  if [ -r /etc/gentoo-release ]; then
    JAVA_HOME=$(java-config --jre-home)
  fi
fi

if $cygwin; then
  [ -n "$JAVA_HOME" ] && JAVA_HOME=$(cygpath --unix "$JAVA_HOME")
  [ -n "$CLASSPATH" ] && CLASSPATH=$(cygpath --path --unix "$CLASSPATH")
fi

if $mingw; then
  [ -n "$JAVA_HOME" ] && [ -d "$JAVA_HOME" ] && JAVA_HOME="$(cd "$JAVA_HOME" && pwd)"
fi

if [ -z "$JAVA_HOME" ]; then
  javaExecutable="$(which javac)"
  if [ -n "$javaExecutable" ]; then
    readLink=$(which readlink)
    if [ ! "$(expr "$readLink" : '\([^ ]*\)')" = "readlink" ]; then
      if $darwin; then
        javaHome="$(dirname "$javaExecutable")"
        javaExecutable="$(cd "$javaHome" && pwd -P)/javac"
      else
        javaExecutable="$(readlink -f "$javaExecutable")"
      fi
    fi
    javaHome="$(dirname "$javaExecutable")"
    JAVA_HOME="$(expr "$javaHome" : '\(.*\)/bin')"
    export JAVA_HOME
  fi
fi

if [ -n "$JAVA_HOME" ]; then
  if $cygwin; then
    JAVACMD="$(cygpath --unix "$JAVA_HOME")/bin/java"
  else
    JAVACMD="$JAVA_HOME/bin/java"
  fi
  if [ ! -x "$JAVACMD" ]; then
    echo "Error: JAVA_HOME is set to an invalid directory: $JAVA_HOME" >&2
    echo "Please set the JAVA_HOME variable in your environment to match the location of your Java installation." >&2
    exit 1
  fi
else
  JAVACMD="java"
  if ! command -v java > /dev/null 2>&1; then
    echo "Error: JAVA_HOME is not set and no 'java' command could be found in your PATH." >&2
    echo "Please set the JAVA_HOME variable in your environment to match the location of your Java installation." >&2
    exit 1
  fi
fi

MAVEN_PROJECTBASEDIR="${MAVEN_BASEDIR:-$(cd "$(dirname "$0")" && pwd)}"
export MAVEN_PROJECTBASEDIR

MAVEN_OPTS="${MAVEN_OPTS:-}"
if [ -n "$MAVEN_ADDITIONAL_OPTS" ]; then
  MAVEN_OPTS="$MAVEN_OPTS $MAVEN_ADDITIONAL_OPTS"
fi

WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_LAUNCHER="org.apache.maven.wrapper.MavenWrapperMain"
WRAPPER_URL=""

if [ -r "$WRAPPER_JAR" ]; then
  if [ "$MVNW_VERBOSE" = true ]; then
    echo "Found .mvn/wrapper/maven-wrapper.jar"
  fi
else
  if [ "$MVNW_VERBOSE" = true ]; then
    echo "Couldn't find .mvn/wrapper/maven-wrapper.jar, downloading it ..."
  fi
  while IFS="=" read -r key value; do
    case "$key" in
      wrapperUrl) WRAPPER_URL="$value"; break ;;
    esac
  done < "$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"
  if [ -z "$WRAPPER_URL" ]; then
    WRAPPER_URL="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar"
  fi
  if [ "$MVNW_VERBOSE" = true ]; then
    echo "Downloading from: $WRAPPER_URL"
  fi
  if command -v wget > /dev/null; then
    [ "$MVNW_VERBOSE" = true ] && QUIET="" || QUIET="--quiet"
    if [ -n "$MVNW_USERNAME" ] && [ -n "$MVNW_PASSWORD" ]; then
      wget $QUIET --http-user="$MVNW_USERNAME" --http-password="$MVNW_PASSWORD" "$WRAPPER_URL" -O "$WRAPPER_JAR" || rm -f "$WRAPPER_JAR"
    else
      wget $QUIET "$WRAPPER_URL" -O "$WRAPPER_JAR" || rm -f "$WRAPPER_JAR"
    fi
  elif command -v curl > /dev/null; then
    [ "$MVNW_VERBOSE" = true ] && QUIET="" || QUIET="--silent"
    if [ -n "$MVNW_USERNAME" ] && [ -n "$MVNW_PASSWORD" ]; then
      curl $QUIET --user "$MVNW_USERNAME:$MVNW_PASSWORD" -o "$WRAPPER_JAR" "$WRAPPER_URL" -f && true || rm -f "$WRAPPER_JAR"
    else
      curl $QUIET -o "$WRAPPER_JAR" "$WRAPPER_URL" -f && true || rm -f "$WRAPPER_JAR"
    fi
  else
    echo "No wget or curl found — please install one or provide the maven-wrapper.jar manually." >&2
    exit 1
  fi
fi

if $cygwin; then
  WRAPPER_JAR=$(cygpath --path --windows "$WRAPPER_JAR")
fi

MAVEN_CONFIG=""
exec "$JAVACMD" \
  $MAVEN_OPTS \
  -classpath "$WRAPPER_JAR" \
  "-Dmaven.multiModuleProjectDirectory=${MAVEN_PROJECTBASEDIR}" \
  ${WRAPPER_LAUNCHER} $MAVEN_CONFIG "$@"
